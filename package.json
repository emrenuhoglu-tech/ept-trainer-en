{
  "name": "ept-trainer-en",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env server/proxy.mjs",
    "selfcheck:build": "node scripts/build-selfcheck.mjs",
    "selfcheck": "npm run selfcheck:build && node scripts/selfcheck.mjs",
    "bake:tts": "node --env-file-if-exists=.env scripts/bake-tts.mjs",
    "prebuild": "npm run selfcheck",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "gapcheck": "node scripts/gapcheck.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.21.5",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
