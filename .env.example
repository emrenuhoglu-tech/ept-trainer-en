# EPT Trainer — environment variables
# Phase 1 (Lessons + Quick Reference) needs NONE of these; Web Speech runs in the browser.

# --- Phase 2: Drill Mode (server/proxy.mjs; the key never leaks to the client) ---
ANTHROPIC_API_KEY=

# Model: fable 5 for everything, falls back to opus on refusal/error (Emre's decision).
ANTHROPIC_MODEL=claude-fable-5
ANTHROPIC_FALLBACK_MODEL=claude-opus-4-8
# Fable 5 always has thinking on, so leave headroom for the JSON output.
ANTHROPIC_MAX_TOKENS=3000

# Proxy port
PORT=8787

# --- Phase 3: natural TTS (optional; falls back to Web Speech if absent) ---
# Keys are used ONLY in the proxy. Toggled in the app via the "HD voice" button.
# Provider: web | openai | elevenlabs  (default: web)
TTS_PROVIDER=openai

# OpenAI TTS (Emre's preference: the new version is very good)
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# ElevenLabs (alternative)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
